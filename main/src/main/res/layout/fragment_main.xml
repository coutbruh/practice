<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.main.MainFragment">

    <!-- EditText для ввода текста -->
    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите название цвета..."
        android:padding="12dp"
        android:inputType="text"
        android:maxLines="1"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="@color/cardview_shadow_start_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Color"
        android:layout_marginTop="16dp"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/editText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button2">


        <TextView
            android:id="@+id/labelPurple500"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_margin="8dp"
        android:background="@color/purple_500"
        android:gravity="center"
        android:padding="12dp"
        android:text="PURPLE 500"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />


        <TextView
            android:id="@+id/labelTeal700"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_margin="8dp"
        android:background="@color/teal_700"
        android:gravity="center"
        android:padding="12dp"
        android:text="TEAL 700"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />


        <TextView
            android:id="@+id/labelPurple200"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_margin="8dp"
        android:background="@color/purple_200"
        android:gravity="center"
        android:padding="12dp"
        android:text="PURPLE 200"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />
        <TextView
            android:id="@+id/labelTeal200"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_margin="8dp"
        android:background="@color/teal_200"
        android:gravity="center"
        android:padding="12dp"
        android:text="TEAL 200"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

        <TextView
            android:id="@+id/labelPurple700"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_margin="8dp"
        android:background="@color/purple_700"
        android:gravity="center"
        android:padding="12dp"
        android:text="PURPLE 700"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>